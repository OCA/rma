<odoo>
    <record model="ir.ui.view" id="rma_form_view">
        <field name="model">rma</field>
        <field name="inherit_id" ref="rma.rma_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='delivered_qty']" position="before">
                <label
                    for="lot_id"
                    string="Lot"
                    invisible="not lots_visible or product_tracking != 'lot'"
                    readonly="state not in ('draft', 'confirmed', 'received', 'waiting_replacement')"
                />
                <label
                    for="lot_id"
                    string="Serial Number"
                    invisible="not lots_visible or product_tracking != 'serial'"
                    readonly="state not in ('draft', 'confirmed', 'received', 'waiting_replacement')"
                />
                <label
                    for="lot_id"
                    string="Lot/Serial Number"
                    invisible="not lots_visible or product_id"
                    readonly="state not in ('draft', 'confirmed', 'received', 'waiting_replacement')"
                />
                <field
                    name="lot_id"
                    nolabel="1"
                    groups="stock.group_production_lot"
                    invisible="not lots_visible"
                    readonly="state not in ('draft', 'confirmed', 'received', 'waiting_replacement')"
                />
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="rma_search_view">
        <field name="model">rma</field>
        <field name="inherit_id" ref="rma.rma_view_search" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="lot_id" groups="stock.group_production_lot" />
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="rma_tree_view">
        <field name="model">rma</field>
        <field name="inherit_id" ref="rma.rma_view_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="lot_id" groups="stock.group_production_lot" />
            </xpath>
        </field>
    </record>
</odoo>
