<odoo>

    <record id="rma_operation_form_view" model="ir.ui.view">
        <field name="model">rma.operation</field>
        <field name="inherit_id" ref="rma_repair.rma_operation_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='action_create_repair']//parent::group/following-sibling::group[1]"
                position="inside"
            >
                <field
                    name="repair_warehouse_id"
                    attrs="{'invisible': [('action_create_repair', '=', False)]}"
                />
                <field
                    name="repair_location_id"
                    attrs="{'invisible': [('action_create_repair', '=', False)]}"
                />
            </xpath>
        </field>
    </record>



</odoo>
