<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="rma_create_rma_action" model="ir.actions.act_window">
        <field name="name">Create RMA</field>
        <field name="res_model">rma.rma.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="rma_rma_wizard_form_view" model="ir.ui.view">
        <field name="name">rma.rma.wizard.form</field>
        <field name="model">rma.rma.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="operation_id" />
                </group>
                <footer>
                    <button
                        name="create_and_open_rma"
                        string="Accept"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
