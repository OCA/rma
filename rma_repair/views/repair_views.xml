<odoo>
    <record id="view_repair_order_form_inherit" model="ir.ui.view">
        <field name="name">repair.order.form.inherit</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_created_invoice']" position="before">
                <field name="rma_ids" readonly="1" invisible="1" />
                <button
                    class="oe_stat_button"
                    name="action_view_repair_rma"
                    type="object"
                    icon="fa-rotate-left"
                    attrs="{'invisible': [('rma_count', '=', 0)]}"
                >
                    <field string="RMA" name="rma_count" widget="statinfo" />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
