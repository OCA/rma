<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block name="catalog_setting_container" position="inside">
                <setting
                    help="When we hit the RMA request button from the portal sale page, open in a single page instead of a popup."
                    company_specific="1"
                >
                    <field
                        name="show_full_page_sale_rma"
                        string="Single page RMA request"
                    />
                </setting>
            </block>
        </field>
    </record>
</odoo>
