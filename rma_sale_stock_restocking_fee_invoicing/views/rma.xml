<odoo>
    <record id="rma_form_view" model="ir.ui.view">
        <field name="model">rma</field>
        <field name="inherit_id" ref="rma.rma_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_refund']" position="after">
                <button
                    type="object"
                    string="Invoice"
                    name="action_view_restocking_fee_invoice"
                    class="oe_stat_button"
                    icon="fa-pencil-square-o"
                    invisible="not restocking_fee_invoice_id"
                />
            </xpath>
        </field>
    </record>
</odoo>
